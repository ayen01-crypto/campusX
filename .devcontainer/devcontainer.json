{
  "name": "CampusX Full Stack",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    }
  },
  "remoteUser": "vscode",
  "forwardPorts": [3000, 4000, 5432, 6379, 9000, 9001],
  "portsAttributes": {
    "3000": {
      "label": "CampusX Flutter Web",
      "onAutoForward": "openPreview"
    },
    "4000": {
      "label": "CampusX API",
      "onAutoForward": "notify"
    },
    "9001": {
      "label": "CampusX Object Storage Console",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "dbaeumer.vscode-eslint",
        "Prisma.prisma",
        "eamodio.gitlens",
        "usernamehw.errorlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "dart.lineLength": 100,
        "dart.flutterHotReloadOnSave": "all",
        "typescript.tsdk": "api/node_modules/typescript/lib"
      }
    }
  },
  "postCreateCommand": "bash tool/bootstrap_platforms.sh && bash tool/bootstrap_api.sh"
}
