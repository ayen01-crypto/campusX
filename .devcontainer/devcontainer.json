{
  "name": "CampusX Flutter",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "CampusX Flutter Web",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "eamodio.gitlens",
        "usernamehw.errorlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "dart.lineLength": 100,
        "dart.flutterHotReloadOnSave": "all"
      }
    }
  },
  "postCreateCommand": "bash tool/bootstrap_platforms.sh"
}
